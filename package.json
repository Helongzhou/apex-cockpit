{
  "name": "apex-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cockpit HMI and ADAS visualisation portfolio project: a Three.js + Rapier driving demo being redeveloped into a TypeScript, React and Vite application.",
  "license": "MIT",
  "author": "HelongZhou",
  "repository": {
    "type": "git",
    "url": "https://github.com/Helongzhou/apex-cockpit.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/ui-smoke.mjs dist",
    "deterministic": "node scripts/compare-deterministic.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "keywords": [
    "threejs",
    "rapier",
    "typescript",
    "react",
    "vite",
    "hmi",
    "adas",
    "automotive",
    "cockpit",
    "visualisation",
    "webgl",
    "portfolio"
  ],
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
